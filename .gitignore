# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---------- Docker ----------
*.log

# ---------- Data (user-specific, not committed) ----------
data/
*.h5ad
*.obo
frontend/.editorconfig
frontend/.gitattributes
backend/guides/CONFIGURATION_GUIDE.md
backend/guides/GO_API_DOCUMENTATION.md
backend/guides/ORA_IMPLEMENTATION.md
backend/guides/README_FRONTEND.md
backend/guides/SAMPLE_METADATA_SUPPORT.md
