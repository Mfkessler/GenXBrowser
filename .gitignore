*$py.class
*.egg-info/
*.egg
dist/
build/
*.so
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.whl
venv/
.venv/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
*.tsbuildinfo
.vitest/
